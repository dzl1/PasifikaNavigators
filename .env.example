# Microsoft Entra External ID (app registration for the website)
VITE_ENTRA_CLIENT_ID=<application-client-id>
VITE_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>
VITE_ENTRA_API_SCOPE=api://<application-client-id>/access_as_user

# Azure Functions API base URL (no trailing slash)
VITE_API_BASE_URL=https://<function-app-name>.azurewebsites.net/api
